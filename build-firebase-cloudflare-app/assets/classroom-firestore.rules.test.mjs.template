import { after, before, test } from "node:test";
import {
  assertFails,
  assertSucceeds,
  initializeTestEnvironment,
} from "@firebase/rules-unit-testing";
import {
  collection,
  deleteDoc,
  doc,
  getDoc,
  getDocs,
  serverTimestamp,
  setDoc,
  updateDoc,
} from "firebase/firestore";
import { readFile } from "node:fs/promises";

const projectId = "demo-classroom-rules";
let rules;

before(async () => {
  rules = await initializeTestEnvironment({
    projectId,
    firestore: {
      rules: await readFile("firestore.rules", "utf8"),
    },
  });

  await rules.withSecurityRulesDisabled(async (context) => {
    const db = context.firestore();
    await setDoc(doc(db, "classes/demo"), {
      name: "Demo class",
      ownerId: "teacher-1",
      createdAt: new Date(),
    });
    await setDoc(doc(db, "classes/demo/members/student-1"), {
      displayName: "Student",
      email: "student@example.test",
      role: "student",
      joinedAt: new Date(),
    });
    await setDoc(doc(db, "classes/demo/members/student-2"), {
      displayName: "Student 2",
      email: "student2@example.test",
      role: "student",
      joinedAt: new Date(),
    });
    await setDoc(doc(db, "classes/demo/polls/poll-1"), {
      question: "Choose one",
      optionIds: ["a", "b"],
      isOpen: true,
      createdAt: new Date(),
    });
    await setDoc(doc(db, "classes/demo/announcements/a-1"), {
      title: "Teacher message",
    });
  });
});

after(async () => {
  await rules?.cleanup();
});

test("a signed-out visitor cannot read class data", async () => {
  const db = rules.unauthenticatedContext().firestore();
  await assertFails(getDoc(doc(db, "classes/demo")));
});

test("a class member can read the class", async () => {
  const db = rules
    .authenticatedContext("student-1", { email: "student@example.test" })
    .firestore();
  await assertSucceeds(getDoc(doc(db, "classes/demo")));
});

test("a student can vote once and cannot replace the vote", async () => {
  const db = rules
    .authenticatedContext("student-1", { email: "student@example.test" })
    .firestore();
  const vote = doc(db, "classes/demo/polls/poll-1/votes/student-1");
  await assertSucceeds(
    setDoc(vote, { optionId: "a", createdAt: serverTimestamp() }),
  );
  await assertFails(updateDoc(vote, { optionId: "b" }));
  await assertFails(deleteDoc(vote));
});

test("a vote must come from a member and use a valid option", async () => {
  const outsider = rules
    .authenticatedContext("outsider-1", { email: "outsider@example.test" })
    .firestore();
  await assertFails(
    setDoc(doc(outsider, "classes/demo/polls/poll-1/votes/outsider-1"), {
      optionId: "a",
      createdAt: serverTimestamp(),
    }),
  );

  const member = rules
    .authenticatedContext("student-2", { email: "student2@example.test" })
    .firestore();
  await assertFails(
    setDoc(doc(member, "classes/demo/polls/poll-1/votes/student-2"), {
      optionId: "not-an-option",
      createdAt: serverTimestamp(),
    }),
  );
});

test("only a teacher can list all votes", async () => {
  const student = rules
    .authenticatedContext("student-1", { email: "student@example.test" })
    .firestore();
  await assertFails(
    getDocs(collection(student, "classes/demo/polls/poll-1/votes")),
  );

  const teacher = rules
    .authenticatedContext("teacher-1", { email: "teacher@example.test" })
    .firestore();
  await assertSucceeds(
    getDocs(collection(teacher, "classes/demo/polls/poll-1/votes")),
  );
});

test("a student cannot edit teacher content", async () => {
  const db = rules
    .authenticatedContext("student-1", { email: "student@example.test" })
    .firestore();
  await assertFails(
    updateDoc(doc(db, "classes/demo/announcements/a-1"), {
      title: "Changed",
    }),
  );
});
